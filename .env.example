# =============================================================================
# Funfram Environment Variables Example
# Copy this file to .env (never commit .env to git)
# =============================================================================

# --- Public Browser URLs (Must be accessible from user browser) ---
NEXT_PUBLIC_WS_GAME_URL=ws://localhost:5001
NEXT_PUBLIC_WS_WEBRTC_URL=ws://localhost:5002
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Runtime Environment & CORS / WebSocket Origin Allowlist ---
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Shared HMAC Secrets (Generate 32+ random bytes hex; keep identical across services) ---
SIGNALING_HMAC_SECRET=replace-with-32-byte-random-hex-signaling
TURN_TOKEN_HMAC_SECRET=replace-with-32-byte-random-hex-turn
INVITE_HMAC_SECRET=replace-with-32-byte-random-hex-invite

# --- Cloudflare Realtime TURN (1,000 GB/month Free Tier) ---
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Optional: Cloudflare Realtime SFU (Fase 2 Hybrid 2v2 & Moderation) ---
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_API_TOKEN=

# --- Persistence (Supabase PostgreSQL Singapore & Local Redis Container) ---
DATABASE_URL=
REDIS_URL=redis://redis:6379
WS_INTERNAL_URL=http://backend-websockets:5001
