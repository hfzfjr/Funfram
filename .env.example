# Frontend Environment Variables
# For Docker Compose (internal network):
NEXT_PUBLIC_WS_GAME_URL=ws://backend-websockets:5001/socket
NEXT_PUBLIC_WS_WEBRTC_URL=ws://backend-webrtc:5002

# For development (localhost):
# NEXT_PUBLIC_WS_GAME_URL=ws://localhost:5001/socket
# NEXT_PUBLIC_WS_WEBRTC_URL=ws://localhost:5002

# For production with Cloudflare tunneling:
# NEXT_PUBLIC_WS_GAME_URL=wss://socket.funfram.com/socket
# NEXT_PUBLIC_WS_WEBRTC_URL=wss://webrtc.funfram.com

# Frontend Port (change if port 3001 is already in use)
# FRONTEND_PORT=3001

# Backend WebSocket (Go) Environment Variables
PORT=5001

# Database (Supabase) - Optional for now
# DATABASE_URL=postgresql://user:password@host:port/database

# Backend WebRTC (Node.js) Environment Variables
PORT=5002

# TURN Server Configuration (Optional - for production)
# TURN_SERVER_URL=turn:turn.funfram.com:3478
# TURN_USERNAME=funfram
# TURN_CREDENTIAL=CHANGE_THIS_TO_STRONG_PASSWORD

# TURN Server (Coturn) Environment Variables
# TURN_EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP
# TURN_REALM=funfram.com
