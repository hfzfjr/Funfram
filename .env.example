# Frontend Environment Variables
# For Docker Compose (internal network):
NEXT_PUBLIC_WS_GAME_URL=ws://backend-websockets:5001
NEXT_PUBLIC_WS_WEBRTC_URL=ws://backend-webrtc:5002
NEXT_PUBLIC_APP_URL=http://localhost:3001

# For development (localhost):
# NEXT_PUBLIC_WS_GAME_URL=ws://localhost:5001
# NEXT_PUBLIC_WS_WEBRTC_URL=ws://localhost:5002
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# For production with Cloudflare tunneling:
# NEXT_PUBLIC_WS_GAME_URL=wss://socket.funfram.roomify.space
# NEXT_PUBLIC_WS_WEBRTC_URL=wss://webrtc.funfram.roomify.space
# NEXT_PUBLIC_APP_URL=https://funfram.roomify.space

# Frontend Port (change if port 3001 is already in use)
# FRONTEND_PORT=3001

# Backend WebSocket (Go) Environment Variables
PORT=5001

# Database (Supabase) - Optional for now
# DATABASE_URL=postgresql://user:password@host:port/database

# Backend WebRTC (Node.js) Environment Variables
PORT=5002

# Server Public IP (Used for TURN server configuration)
SERVER_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP

# TURN Server Configuration (Optional - for production)

# PUBLIC TURN SERVER (OpenRelay - Free, No Setup Required)
# Recommended for development/testing
TURN_SERVER_URL=turn:openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# LOCAL TURN SERVER (Coturn - Self-Hosted)
# Recommended for production - requires setup and firewall configuration
# TURN_SERVER_URL=turn:${SERVER_PUBLIC_IP}:3478
# TURN_USERNAME=funfram
# TURN_CREDENTIAL=CHANGE_THIS_TO_STRONG_PASSWORD

# TURN Server (Coturn) Environment Variables (Only for LOCAL TURN)
# TURN_EXTERNAL_IP=${SERVER_PUBLIC_IP}
# TURN_REALM=funfram.com
# AUTOMAP_HELPER_EXTERNAL_IP=${SERVER_PUBLIC_IP}
